# ============================================================
# SENI CORP — Application metier
# Copier en .env.local pour le developpement.
# ============================================================

# Origine du backend, utilisee UNIQUEMENT cote serveur par le proxy Next
# (voir rewrites() dans next.config.ts). Ne JAMAIS la prefixer NEXT_PUBLIC_.
#
#   backend local  : http://localhost:3001
#   sur Railway    : http://<service-backend>.railway.internal:8080
BACKEND_ORIGIN=http://localhost:3001

# Base de l'API vue du navigateur. Chemin relatif : les appels passent par
# le domaine de l'application, ce qui rend les cookies de session
# first-party. Ne jamais mettre d'URL absolue ici.
NEXT_PUBLIC_API_URL=/api/v1
